{
  "schema": 1,
  "note": "内置文献数据库目录。entry 是走出 WebVPN 后用于『确认已登上数据库』的首页地址；verify 规则可被 state/fingerprints.json 里校准出的指纹覆盖。",
  "defaults": {
    "verify": {
      "expect_status": [200, 201, 202, 203, 206, 301, 302, 303, 304],
      "min_bytes": 1000,
      "institution_patterns": [
        "(?:机构用户|所属机构|欢迎|您好|登录用户|当前IP|institution|orgName|entitled)[^<>]{0,40}(?:{inst})",
        "(?:{inst})[^<>]{0,20}(?:图书馆|读者|用户|机构)"
      ],
      "forbid_any": [
        "请登录|统一身份认证平台|请输入学号|账号登录|Sign in to your account",
        "authserver/login|/cas/login|login[.]jsp", "authserver/login|/cas/login"
      ]
    }
  },
  "databases": {
    "sd": {
      "name": "ScienceDirect (Elsevier)",
      "host": "www.sciencedirect.com",
      "scheme": "https",
      "entry": "/",
      "tags": ["英文", "全文", "理工"],
      "_note": "实测：校内 IP 直连时页面里就带 orgName:Hohai University，作为首选判定标记",
      "verify": { "require_any": ["(?i)orgName.{0,3}[:=].{0,3}(?:河海|hohai)"] }
    },
    "cnki": {
      "name": "中国知网 CNKI",
      "host": "www.cnki.net",
      "scheme": "https",
      "entry": "/",
      "tags": ["中文", "全文", "期刊/学位论文"],
      "_note": "实测：CNKI 首页的「机构用户」四字与认证无关（它只是「全球学术快报」链接旁的标签），不能作为依据。",
      "verify": {
        "require_any": ["(?i)(?:欢迎|机构用户|所属机构|登录)[^<>]{0,30}(?:河海|hohai)"],
        "verify_note": "实测（2026-09-16，校园网 + 已登录 WebVPN）：www.cnki.net 首页静态 HTML 里不出现机构名，只用脚本看不到认证状态；请用浏览器打开核对页面上的机构信息，或直接用它检索（能下全文即说明已授权）。"
      }
    },
    "cnki-kns": {
      "name": "中国知网 检索平台 (kns)",
      "host": "kns.cnki.net",
      "scheme": "https",
      "entry": "/kns8s/",
      "tags": ["中文", "检索入口"],
      "_note": "实测：kns 无论直连还是走 WebVPN，都先返回 CNKI 的「安全验证」反爬页（约 4KB），脚本拿不到真实页面。",
      "verify": {
        "require_any": ["(?i)(?:欢迎|机构用户|所属机构|登录)[^<>]{0,30}(?:河海|hohai)"],
        "verify_note": "实测（2026-09-16）：kns.cnki.net 会先给反爬「安全验证」页，脚本无法判定认证状态——请在浏览器里确认。"
      }
    },
